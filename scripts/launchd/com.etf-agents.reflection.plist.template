<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每週五 19:30（主機時區 Asia/Taipei）跑策略反思：週五 20:00 的資料更新與 21:00 決策都還沒開始，
     此時只產生診斷包、每週反思報告（var/strategy_reflection/reports/weekly-<日期>.md）並封存提案，**不套用**。
     提案由另一個排程（com.etf-agents.reflection-apply，週六 10:00）套用，避開 20:50～09:00 的封鎖窗；
     週日 21:00 是第一個讀到新策略的決策。累積決策日不足時不呼叫 Agent（零用量），仍會產生報告。
     改壞可用 .venv/bin/python cli/strategy_reflection.py rollback 還原。
     安裝：把 __PROJECT_ROOT__ 與 __HOME__ 換成實際路徑，mkdir -p __PROJECT_ROOT__/var/logs，複製到 ~/Library/LaunchAgents/ 後 launchctl load。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.etf-agents.reflection</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>__PROJECT_ROOT__/.venv/bin/python</string>
    <string>__PROJECT_ROOT__/cli/strategy_reflection.py</string>
    <string>auto</string>
    <string>--no-apply</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TZ</key>
    <string>Asia/Taipei</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/var/logs/strategy-reflection-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/var/logs/strategy-reflection-launchd.log</string>
</dict>
</plist>
