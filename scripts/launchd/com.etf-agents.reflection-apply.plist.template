<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每週六 10:00（主機時區 Asia/Taipei）套用週五封存、尚未套用且未過期的反思提案：
     仍要通過重建驗證、影子回放、取鎖與「20:50～09:00 不套用」的保護；沒有提案時什麼都不做。
     安裝同 com.etf-agents.reflection：把 __PROJECT_ROOT__ 與 __HOME__ 換成實際路徑，複製到 ~/Library/LaunchAgents/ 後 launchctl load。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.etf-agents.reflection-apply</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>__PROJECT_ROOT__/.venv/bin/python</string>
    <string>__PROJECT_ROOT__/cli/strategy_reflection.py</string>
    <string>apply-pending</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>TZ</key>
    <string>Asia/Taipei</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/var/logs/strategy-reflection-apply-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/var/logs/strategy-reflection-apply-launchd.log</string>
</dict>
</plist>
